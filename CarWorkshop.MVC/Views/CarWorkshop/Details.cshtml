@model CarWorkshop.Application.CarWorkshop.CarWorkshopDto

@{
ViewData["Title"] = "Details";
}

<h1>@Model.Name Details</h1>

<div>
    <h4>CarWorkshop.Domain.TestsDto</h4>
    <hr />
    <dl class="row">
       

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.About)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.About)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PhoneNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PhoneNumber)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Street)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Street)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PostalCode)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PostalCode)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.City)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.City)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
    </dl>
</div>
<h3>Services:</h3>
<div id="service" class="row" data-encoded-name="@Model.EncodedName"></div>
<div>
    @if (Model.IsEdible)
    {
        <a asp-action="Edit" asp-route-encodedName="@Model.EncodedName" asp-controller="CarWorkshop" asp-action="Edit" class="btn btn-primary">Edit</a> 

    }
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
@section Scripts {
    <script src="~/js/CarWorkshop/Details.js"></script>
}