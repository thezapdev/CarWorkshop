@model IEnumerable<CarWorkshop.Application.CarWorkshop.CarWorkshopDto>

@{
    ViewData["Title"] = "Index";
}

<p>
    <a asp-action="Create" class="btn btn-secondary">Create New</a>
</p>

<h1>Carworkshop</h1>


<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text">@item.Description</p>
                    <a class="btn btn-primary" asp-action="Details" asp-controller="CarWorkshop" asp-route-encodedName="@item.EncodedName">Details</a>
                    @if (item.IsEdible)
                    {
                        <a class="btn btn-outline-secondary" asp-action="Edit" asp-controller="CarWorkshop" asp-route-encodedName="@item.EncodedName">Edit</a>

                    }
                </div>
            </div>
        </div>
    }
</div>